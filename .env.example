# Скопируйте в .env для локального запуска. В проде (Railway/Render) эти же
# имена задаются в настройках окружения сервиса — .env туда не попадает.

ANTHROPIC_API_KEY=

# Sanity — токен должен быть с правом Viewer (только чтение), достаточно для
# этого сервиса; отдельный от токена записи, которым пользуется сам сайт.
SANITY_PROJECT_ID=70uy4yts
SANITY_DATASET=production
SANITY_READ_TOKEN=

# Домены, которым разрешено обращаться к этому API из браузера (CORS),
# через запятую. Для локальной разработки сайта — localhost.
ALLOWED_ORIGINS=https://sanbazar.com,http://localhost:3000
